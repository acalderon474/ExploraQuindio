<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout del fragmento de video de Explora Quindío.

    Organiza la interfaz dentro de un ScrollView para adaptarse
    a pantallas pequeñas. El contenido se estructura así:
      1. Encabezado con título, subtítulo y chip identificador.
      2. Título del contenido del video.
      3. Contenedor del reproductor con VideoView, ProgressBar
         y botón de pantalla completa superpuestos.
      4. SeekBar con tiempo actual y total.
      5. Texto de estado del reproductor.
      6. Fila de botones Play y Pausa.
      7. Fila de botones Retroceder y Avanzar.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoFragmentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/explora_fondo"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ────────────────────────────────────────────
             Encabezado de la sección
             Muestra el título, subtítulo y el chip "Video"
             alineados horizontalmente.
        ──────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Bloque de título y subtítulo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Título principal de la sección -->
                <TextView
                    android:id="@+id/tvTituloSeccionVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/video_titulo_seccion"
                    android:textColor="@color/explora_texto_oscuro"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Subtítulo descriptivo de la sección -->
                <TextView
                    android:id="@+id/tvSubtituloVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/video_subtitulo"
                    android:textColor="@color/explora_texto_secundario"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Chip identificador de la sección -->
            <TextView
                android:id="@+id/txtVideoChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/profile_chip_background"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/video_chip"
                android:textColor="@color/explora_verde"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Título del video que se va a reproducir -->
        <TextView
            android:id="@+id/tvTituloVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/video_titulo_contenido"
            android:textColor="@color/explora_verde"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- ────────────────────────────────────────────
             Contenedor del reproductor de video
             FrameLayout apila tres elementos:
               1. VideoView: renderiza el video.
               2. ProgressBar: visible mientras carga.
               3. Botón pantalla completa: esquina superior
                  derecha, siempre accesible.
             La altura fija de 220dp garantiza una
             relación de aspecto consistente.
        ──────────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/videoFrame"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/frag_bg_video"
            android:padding="4dp">

            <!-- Reproductor de video nativo de Android -->
            <VideoView
                android:id="@+id/videoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- Indicador de carga circular; visible solo mientras
                 el video se prepara, se oculta en onPrepared -->
            <ProgressBar
                android:id="@+id/progressVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/explora_naranja" />

            <!-- Botón de pantalla completa superpuesto en la
                 esquina superior derecha del reproductor.
                 Permanece habilitado en todo momento. -->
            <Button
                android:id="@+id/btnPantallaCompleta"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:backgroundTint="@color/explora_verde"
                android:contentDescription="@string/video_descripcion_pantalla_completa"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/video_btn_pantalla_completa"
                android:textColor="@android:color/white"
                android:textSize="18sp" />
        </FrameLayout>

        <!-- ────────────────────────────────────────────
             Barra de progreso y tiempo
             La SeekBar ocupa el espacio disponible
             (weight=1) y el TextView de tiempo se
             ajusta a su contenido a la derecha.
        ──────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Barra deslizable para controlar la posición del video -->
            <SeekBar
                android:id="@+id/seekVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/explora_naranja"
                android:thumbTint="@color/explora_naranja" />

            <!-- Tiempo actual y duración total en formato mm:ss / mm:ss -->
            <TextView
                android:id="@+id/tvTiempoVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/video_tiempo_inicial"
                android:textColor="@color/explora_texto_oscuro"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Texto de estado del reproductor: refleja en todo momento
             si el video está cargando, listo, reproduciéndose,
             en pausa, avanzando, retrocediendo, finalizado o en error -->
        <TextView
            android:id="@+id/tvEstadoVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/video_estado_cargando"
            android:textColor="@color/explora_verde"
            android:textSize="14sp" />

        <!-- ────────────────────────────────────────────
             Fila de controles principales: Play y Pausa
             Cada botón ocupa el 50% del ancho disponible
             mediante layout_weight="1".
        ──────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Inicia o reanuda la reproducción del video -->
            <Button
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/explora_verde"
                android:contentDescription="@string/video_descripcion_play"
                android:minWidth="0dp"
                android:text="@string/video_btn_play"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <!-- Pausa la reproducción del video -->
            <Button
                android:id="@+id/btnPausa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/explora_naranja"
                android:contentDescription="@string/video_descripcion_pausa"
                android:minWidth="0dp"
                android:text="@string/video_btn_pausa"
                android:textAllCaps="false"
                android:textColor="@color/explora_texto_oscuro" />
        </LinearLayout>

        <!-- ────────────────────────────────────────────
             Fila de controles secundarios: Retroceder y Avanzar
             Cada botón salta 10 segundos en su dirección.
        ──────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <!-- Retrocede 10 segundos en la reproducción -->
            <Button
                android:id="@+id/btnRetroceder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/explora_divisor"
                android:contentDescription="@string/video_descripcion_retroceder"
                android:minWidth="0dp"
                android:text="@string/video_btn_retroceder"
                android:textAllCaps="false"
                android:textColor="@color/explora_verde" />

            <!-- Avanza 10 segundos en la reproducción -->
            <Button
                android:id="@+id/btnAvanzar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/explora_divisor"
                android:contentDescription="@string/video_descripcion_avanzar"
                android:minWidth="0dp"
                android:text="@string/video_btn_avanzar"
                android:textAllCaps="false"
                android:textColor="@color/explora_verde" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>