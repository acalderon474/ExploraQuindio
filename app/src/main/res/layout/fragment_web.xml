<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBF5"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTituloSeccionWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explora la web"
        android:textColor="#2B2B2B"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtituloWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Escribe una dirección para cargarla dentro de la aplicación."
        android:textColor="#6B6B6B"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="https://www.sitio-turistico.com"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="#2B2B2B"
            android:textColorHint="#9E9E9E"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCargarWeb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#1B5E20"
            android:text="Cargar página"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvUrlActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Ninguna página cargada"
        android:textColor="#6B6B6B"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/progressWeb"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progressTint="#F9A825"
        android:visibility="invisible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/frag_bg_card"
        android:padding="1dp">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Se muestra al inicio y cuando hay un error (URL inválida / sin conexión) -->
        <LinearLayout
            android:id="@+id/layoutPlaceholderWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvPlaceholderTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Navegador turístico"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlaceholderMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="La página seleccionada aparecerá en este espacio."
                android:textColor="#6B6B6B"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
