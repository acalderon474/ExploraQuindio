<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webFragmentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/explora_fondo"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Encabezado de la sección -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloSeccionWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/web_titulo_seccion"
                android:textColor="@color/explora_texto_oscuro"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtituloWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/web_subtitulo"
                android:textColor="@color/explora_texto_secundario"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtWebChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/profile_chip_background"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/web_chip"
            android:textColor="@color/explora_verde"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dirección a cargar -->
    <EditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/web_hint_url"
        android:imeOptions="actionGo"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/explora_texto_oscuro"
        android:textColorHint="@color/explora_texto_secundario"
        android:textSize="15sp" />

    <!--
        Se coloca debajo del EditText.
        Dentro del panel derecho 70 %, esta distribución ofrece más espacio
        para escribir una URL que una fila EditText + Button.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAtrasWeb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/explora_divisor"
            android:enabled="false"
            android:text="@string/web_btn_atras"
            android:textAllCaps="false"
            android:textColor="@color/explora_verde" />

        <Button
            android:id="@+id/btnCargarWeb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/explora_verde"
            android:text="@string/web_btn_cargar"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvUrlActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/web_sin_pagina"
        android:textColor="@color/explora_texto_secundario"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/progressWeb"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progressTint="@color/explora_naranja"
        android:visibility="invisible" />

    <!-- Navegador interno -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/web_container_background"
        android:clipToOutline="true"
        android:padding="1dp">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:overScrollMode="ifContentScrolls" />

        <!--
            Aparece al iniciar o cuando no es posible mostrar una página.
            El padre recorta el contenido según web_container_background.
        -->
        <LinearLayout
            android:id="@+id/layoutPlaceholderWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvPlaceholderTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/web_placeholder_inicial_titulo"
                android:textColor="@color/explora_verde"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlaceholderMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/web_placeholder_inicial_mensaje"
                android:textColor="@color/explora_texto_secundario"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>