<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout del fragmento de navegación web de Explora Quindío.

    Organiza la interfaz verticalmente en las siguientes secciones:
      1. Encabezado con título, subtítulo y chip identificador.
      2. Campo de texto para ingresar la URL.
      3. Botón para cargar la página.
      4. Texto de estado con la URL actual o el estado de carga.
      5. Barra de progreso horizontal de carga.
      6. Contenedor que alterna entre el WebView y el placeholder.

    Usa un LinearLayout vertical como raíz para que el WebView
    ocupe todo el espacio restante mediante layout_weight="1".
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webFragmentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/explora_fondo"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ────────────────────────────────────────────
         Encabezado de la sección
         Muestra el título, subtítulo y el chip "Web"
         alineados horizontalmente.
    ──────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Bloque de título y subtítulo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Título principal de la sección -->
            <TextView
                android:id="@+id/tvTituloSeccionWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/web_titulo_seccion"
                android:textColor="@color/explora_texto_oscuro"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Subtítulo descriptivo de la sección -->
            <TextView
                android:id="@+id/tvSubtituloWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/web_subtitulo"
                android:textColor="@color/explora_texto_secundario"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Chip identificador de la sección -->
        <TextView
            android:id="@+id/txtWebChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/profile_chip_background"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/web_chip"
            android:textColor="@color/explora_verde"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ────────────────────────────────────────────
         Campo de entrada de URL
         El tipo de entrada textUri activa el teclado
         apropiado. imeOptions="actionGo" muestra el
         botón "Ir" en el teclado, que también dispara
         la carga. importantForAutofill="no" evita que
         el sistema sugiera autocompletado innecesario.
    ──────────────────────────────────────────── -->
    <EditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/web_hint_url"
        android:imeOptions="actionGo"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/explora_texto_oscuro"
        android:textColorHint="@color/explora_texto_secundario"
        android:textSize="15sp" />

    <!-- Botón que dispara la carga de la URL ingresada.
         Alineado al final (derecha) del contenedor. -->
    <Button
        android:id="@+id/btnCargarWeb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        android:backgroundTint="@color/explora_verde"
        android:text="@string/web_btn_cargar"
        android:textAllCaps="false"
        android:textColor="@android:color/white" />

    <!-- Texto de estado que muestra la URL cargada actualmente,
         el progreso de carga o el mensaje de error.
         ellipsize="end" trunca URLs largas con "…" -->
    <TextView
        android:id="@+id/tvUrlActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/web_sin_pagina"
        android:textColor="@color/explora_texto_secundario"
        android:textSize="12sp" />

    <!-- Barra de progreso horizontal que refleja el porcentaje
         de carga de la página (0–100). Se muestra durante la
         carga y se oculta al terminar. visibility="invisible"
         reserva el espacio para evitar saltos de layout. -->
    <ProgressBar
        android:id="@+id/progressWeb"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progressTint="@color/explora_naranja"
        android:visibility="invisible" />

    <!-- ────────────────────────────────────────────
         Contenedor principal: WebView + Placeholder
         layout_weight="1" hace que ocupe todo el
         espacio vertical restante. El FrameLayout
         apila el WebView y el placeholder; solo uno
         es visible a la vez según el estado de carga.
    ──────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/web_container_background"
        android:padding="1dp">

        <!-- WebView que renderiza el contenido web.
             Se gestiona completamente desde WebFragment. -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ────────────────────────────────────────────
             Placeholder informativo
             Se superpone al WebView y es visible cuando:
               - No se ha cargado ninguna página (inicial).
               - La URL ingresada es inválida o está vacía.
               - Ocurrió un error de red o HTTP.
             Se oculta (View.GONE) al cargar exitosamente.
        ──────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutPlaceholderWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título del placeholder (varía según el estado) -->
            <TextView
                android:id="@+id/tvPlaceholderTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/web_placeholder_inicial_titulo"
                android:textColor="@color/explora_verde"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Mensaje descriptivo del placeholder (varía según el estado) -->
            <TextView
                android:id="@+id/tvPlaceholderMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/web_placeholder_inicial_mensaje"
                android:textColor="@color/explora_texto_secundario"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>