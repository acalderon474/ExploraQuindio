<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Encabezado superior -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/imgAppLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/app_logo_descripcion"
            android:scaleType="centerInside"
            android:src="@drawable/logo_explora_quindio" />

        <LinearLayout
            android:id="@+id/headerTextContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAppTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/explora_verde"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAppSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/app_subtitulo"
                android:textColor="@color/explora_texto_secundario"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Línea divisoria bajo el encabezado -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/explora_divisor" />

    <!-- Área principal: menú + contenido -->
    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Menú lateral: aproximadamente 30 % -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/menuContainer"
            android:name="com.angelrincon.exploraquindio.fragments.MenuFragment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            tools:layout="@layout/fragment_menu" />

        <!-- Divisor entre menú y contenido -->
        <View
            android:id="@+id/menuContentDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/explora_divisor" />

        <!-- Área dinámica: aproximadamente 70 % -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/contentContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7"
            tools:layout="@layout/fragment_profile" />

    </LinearLayout>

</LinearLayout>